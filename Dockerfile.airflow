# Imagem do Airflow com as dependências do pipeline de treino (DVC + sklearn).
# Usada apenas pela orquestração local (docker-compose.airflow.yml) — a imagem
# de serving da API é o Dockerfile da raiz e não inclui nada disto.
FROM apache/airflow:3.1.7-python3.11

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

# Mesma versão de uv usada pelo projeto (os stages do dvc.yaml executam
# `uv run --no-sync ...`, e o pyproject exige uv >=0.12.6,<0.13).
COPY --from=ghcr.io/astral-sh/uv:0.12.6 /uv /uvx /bin/
USER airflow

# O repositório é montado como volume; o git dentro do container precisa
# confiar no diretório (dono difere por causa do bind mount).
RUN git config --global --add safe.directory /opt/airflow/project

# CLI do DVC no ambiente do Airflow, exportado do uv.lock. Pacotes de serving
# (fastapi/uvicorn/starlette etc.) são filtrados para não sobrescrever as
# versões internas do Airflow. Gerado por:
#   uv export --no-dev --group mlops --no-emit-project --no-hashes \
#     | grep -vE '^(fastapi|uvicorn|starlette|httptools|watchfiles|websockets|python-dotenv|prometheus-client|h11|httpcore2|httpx2)==' \
#     > requirements-airflow.txt
COPY requirements-airflow.txt /tmp/requirements-airflow.txt
RUN pip install --no-cache-dir -r /tmp/requirements-airflow.txt

# O pip traz um uv antigo como dependência transitiva e ~/.local/bin vem
# antes de /bin no PATH; o binário oficial 0.12.6 precisa vencer.
RUN ln -sf /bin/uv /home/airflow/.local/bin/uv

# O .venv montado do host é do Windows e não serve no container. O uv é
# redirecionado para um venv Linux pré-criado aqui a partir do uv.lock —
# assim os stages (`uv run --no-sync python -m src...`) rodam sem alterações.
ENV UV_PROJECT_ENVIRONMENT=/home/airflow/project-venv
COPY pyproject.toml uv.lock /tmp/project/
RUN cd /tmp/project \
    && uv sync --locked --no-default-groups --no-install-project --no-cache

ENV DVC_NO_ANALYTICS=1
